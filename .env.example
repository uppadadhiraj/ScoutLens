# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# --- SerpApi (required for live investigations) ---------------------------
# Get a key at https://serpapi.com/manage-api-key
SERPAPI_KEY=
# Localisation for Google results (India by default)
SERPAPI_GL=in
SERPAPI_HL=en
SERPAPI_LOCATION=India

# --- LLM (choose one provider) --------------------------------------------
# ollama | openai | none   ("none" = deterministic analysis only, no LLM calls)
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI-compatible API (OpenAI, Groq, Together, LM Studio, vLLM, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- App -------------------------------------------------------------------
CACHE_TTL_HOURS=24
MAX_RESUME_MB=5
LOG_LEVEL=INFO
# Timezone used for the "search timestamp" shown in reports
DISPLAY_TIMEZONE=Asia/Kolkata

# --- Advanced (optional) ---------------------------------------------------
# SQLite file for cache + history. Use a local path if your project folder is cloud-synced.
# DB_PATH=data/scoutlens.db
# Result pages per job search; each page costs one SerpApi credit when not cached.
# COMPANY_JOB_PAGES=2
# MARKET_PAGES=3
# Budget for adaptive follow-up searches (official site / funding / fallbacks)
# MAX_FOLLOW_UP_SEARCHES=3
# Let the LLM propose up to 2 extra search queries (validated and capped)
# LLM_PLANNING=false
