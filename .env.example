# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# --- SerpApi (required for live investigations) ---------------------------
# Get a key at https://serpapi.com/manage-api-key
SERPAPI_KEY=
# Localisation for Google results (India by default)
SERPAPI_GL=in
SERPAPI_HL=en
SERPAPI_LOCATION=India

# --- LLM (choose one provider) --------------------------------------------
# ollama | openai | none   ("none" = deterministic analysis only, no LLM calls)
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI-compatible API (OpenAI, Groq, Together, LM Studio, vLLM, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- App -------------------------------------------------------------------
CACHE_TTL_HOURS=24
MAX_RESUME_MB=5
LOG_LEVEL=INFO
